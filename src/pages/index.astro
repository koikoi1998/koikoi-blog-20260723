---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { seriesNames, subSeriesNames } from "../consts";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.series.localeCompare(b.data.series) || a.data.order - b.data.order
);

const bySeries = Map.groupBy(articles, (a) => a.data.series);

// サブシリーズの表示順(main → supplementary → handson → それ以外はconsts.tsの登場順)
const subSeriesOrder = Object.keys(subSeriesNames);
const subSeriesOf = (series: string) => {
  const values = new Set((bySeries.get(series) ?? []).map((a) => a.data.subSeries).filter((v): v is string => !!v));
  return [...values].sort((a, b) => {
    const ia = subSeriesOrder.indexOf(a);
    const ib = subSeriesOrder.indexOf(b);
    if (ia === -1 && ib === -1) return a.localeCompare(b);
    if (ia === -1) return 1;
    if (ib === -1) return -1;
    return ia - ib;
  });
};

const formatDate = (date: Date) =>
  date.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" }).replaceAll("/", ".");
---

<BaseLayout title="トップ" description="インフラエンジニア上位1%レベルの理解を目指す技術ブログ" lang="ja" altHref="/en">
  <div class="hero">
    <span class="eyebrow">// TOP 1% INFRA ENGINEERING</span>
    <h1>インフラの深淵を、上位1%の解像度で。</h1>
    <p>
      AWS・Googleのような最高峰のインフラ企業に在籍するトップ層が持つ理解水準を目指す技術ブログです。
      操作手順の暗記ではなく、なぜそう設計されているのかという内部動作・設計思想まで掘り下げます。
      読む順番やシリーズ間のつながりは<a href="/sitemap">サイトマップ</a>にまとめています。
    </p>
    <div class="hero-stats">
      <div><strong>{articles.length}</strong><span>本の記事</span></div>
      <div><strong>{bySeries.size}</strong><span>シリーズ</span></div>
    </div>
  </div>

  <div class="article-filters" id="article-filters">
    <span class="article-filters-label">絞り込み:</span>
    <button type="button" class="filter-chip filter-chip-reset is-active" data-filter-type="all">すべて</button>
    {
      [...bySeries.keys()].map((series) => (
        <button type="button" class="filter-chip" data-filter-type="series" data-filter-value={series}>
          {seriesNames[series] ?? series}
        </button>
      ))
    }
  </div>

  <div class="article-subfilters" id="article-subfilters">
    {
      [...bySeries.keys()]
        .map((series) => ({ series, subs: subSeriesOf(series) }))
        .filter(({ subs }) => subs.length > 1)
        .map(({ series, subs }) => (
          <div class="subfilter-group" data-parent-series={series} hidden>
            <span class="article-filters-label">↳ {seriesNames[series] ?? series}の中で絞り込み:</span>
            <button type="button" class="filter-chip filter-chip-reset is-active" data-filter-type="sub-all" data-parent-series={series}>
              すべて
            </button>
            {subs.map((sub) => (
              <button type="button" class="filter-chip" data-filter-type="sub-series" data-parent-series={series} data-filter-value={sub}>
                {subSeriesNames[sub] ?? sub}
              </button>
            ))}
          </div>
        ))
    }
  </div>

  {
    [...bySeries.entries()].map(([series, items]) => (
      <section class="series-section" data-series={series}>
        <h2>
          {seriesNames[series] ?? series}
          <span class="series-count">{items.length}本</span>
        </h2>
        <ul class="card-list">
          {items.map((article) => (
            <li data-sub-series={article.data.subSeries ?? ""}>
              <a class="card" href={`/articles/${article.id}`}>
                <p class="card-title">
                  {article.data.emoji ? `${article.data.emoji} ` : ""}
                  {article.data.title}
                </p>
                <p class="card-desc">{article.data.description}</p>
                <div class="card-meta">
                  <span class="card-date">{formatDate(article.data.pubDate)}</span>
                  {article.data.updatedDate && article.data.updatedDate.getTime() !== article.data.pubDate.getTime() && (
                    <span class="card-date card-date-updated">更新: {formatDate(article.data.updatedDate)}</span>
                  )}
                  <ul class="tag-list">
                    {article.data.tags.map((tag: string) => (
                      <li class="tag">#{tag}</li>
                    ))}
                  </ul>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <p class="article-filters-empty" id="article-filters-empty">該当する記事が見つかりませんでした。</p>

  <script>
    const filterBar = document.getElementById("article-filters");
    const subFilterBar = document.getElementById("article-subfilters");
    const emptyMsg = document.getElementById("article-filters-empty");

    let activeSeries = "all";
    let activeSub = "all";

    function applyFilter() {
      const sections = document.querySelectorAll<HTMLElement>(".series-section");
      let visibleCount = 0;

      sections.forEach((section) => {
        const isActiveSeries = activeSeries === "all" || section.dataset.series === activeSeries;
        let sectionHasVisible = false;
        section.querySelectorAll<HTMLLIElement>(".card-list > li").forEach((li) => {
          const subMatches = activeSeries === "all" || activeSub === "all" || li.dataset.subSeries === activeSub;
          const matches = isActiveSeries && subMatches;
          li.classList.toggle("is-hidden", !matches);
          if (matches) sectionHasVisible = true;
        });
        section.classList.toggle("is-hidden", !sectionHasVisible);
        if (sectionHasVisible) visibleCount++;
      });

      emptyMsg?.classList.toggle("is-visible", visibleCount === 0);

      // 選択中のシリーズに対応するサブフィルタ行だけを表示する
      subFilterBar?.querySelectorAll<HTMLElement>(".subfilter-group").forEach((group) => {
        group.hidden = group.dataset.parentSeries !== activeSeries;
      });
    }

    filterBar?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-chip");
      if (!btn) return;

      filterBar.querySelectorAll(".filter-chip").forEach((c) => c.classList.remove("is-active"));
      btn.classList.add("is-active");

      activeSeries = btn.dataset.filterType === "series" ? (btn.dataset.filterValue ?? "all") : "all";
      activeSub = "all";

      // 新しく選んだシリーズのサブフィルタ行を「すべて」の状態にリセットする
      subFilterBar?.querySelectorAll<HTMLElement>(`.subfilter-group[data-parent-series="${activeSeries}"] .filter-chip`).forEach((c) => {
        c.classList.toggle("is-active", c.getAttribute("data-filter-type") === "sub-all");
      });

      applyFilter();
    });

    subFilterBar?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-chip");
      if (!btn) return;

      const group = btn.closest<HTMLElement>(".subfilter-group");
      group?.querySelectorAll(".filter-chip").forEach((c) => c.classList.remove("is-active"));
      btn.classList.add("is-active");

      activeSub = btn.dataset.filterType === "sub-series" ? (btn.dataset.filterValue ?? "all") : "all";
      applyFilter();
    });
  </script>
</BaseLayout>
