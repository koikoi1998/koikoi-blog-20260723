---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { seriesNames } from "../consts";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.series.localeCompare(b.data.series) || a.data.order - b.data.order
);

const bySeries = Map.groupBy(articles, (a) => a.data.series);

const formatDate = (date: Date) =>
  date.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" }).replaceAll("/", ".");
---

<BaseLayout title="トップ" description="インフラエンジニア上位1%レベルの理解を目指す技術ブログ" lang="ja" altHref="/en">
  <div class="hero">
    <span class="eyebrow">// TOP 1% INFRA ENGINEERING</span>
    <h1>インフラの深淵を、上位1%の解像度で。</h1>
    <p>
      AWS・Googleのような最高峰のインフラ企業に在籍するトップ層が持つ理解水準を目指す技術ブログです。
      操作手順の暗記ではなく、なぜそう設計されているのかという内部動作・設計思想まで掘り下げます。
      読む順番やシリーズ間のつながりは<a href="/sitemap">サイトマップ</a>にまとめています。
    </p>
    <div class="hero-stats">
      <div><strong>{articles.length}</strong><span>本の記事</span></div>
      <div><strong>{bySeries.size}</strong><span>シリーズ</span></div>
    </div>
  </div>

  <div class="article-filters" id="article-filters">
    <span class="article-filters-label">絞り込み:</span>
    <button type="button" class="filter-chip filter-chip-reset is-active" data-filter-type="all">すべて</button>
    {
      [...bySeries.keys()].map((series) => (
        <button type="button" class="filter-chip" data-filter-type="series" data-filter-value={series}>
          {seriesNames[series] ?? series}
        </button>
      ))
    }
  </div>

  {
    [...bySeries.entries()].map(([series, items]) => (
      <section class="series-section" data-series={series}>
        <h2>
          {seriesNames[series] ?? series}
          <span class="series-count">{items.length}本</span>
        </h2>
        <ul class="card-list">
          {items.map((article) => (
            <li>
              <a class="card" href={`/articles/${article.id}`}>
                <p class="card-title">
                  {article.data.emoji ? `${article.data.emoji} ` : ""}
                  {article.data.title}
                </p>
                <p class="card-desc">{article.data.description}</p>
                <div class="card-meta">
                  <span class="card-date">{formatDate(article.data.pubDate)}</span>
                  {article.data.updatedDate && article.data.updatedDate.getTime() !== article.data.pubDate.getTime() && (
                    <span class="card-date card-date-updated">更新: {formatDate(article.data.updatedDate)}</span>
                  )}
                  <ul class="tag-list">
                    {article.data.tags.map((tag: string) => (
                      <li class="tag">#{tag}</li>
                    ))}
                  </ul>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <p class="article-filters-empty" id="article-filters-empty">該当する記事が見つかりませんでした。</p>

  <script>
    const filterBar = document.getElementById("article-filters");
    const emptyMsg = document.getElementById("article-filters-empty");
    if (filterBar) {
      filterBar.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-chip");
        if (!btn) return;

        filterBar.querySelectorAll(".filter-chip").forEach((c) => c.classList.remove("is-active"));
        btn.classList.add("is-active");

        const type = btn.dataset.filterType;
        const value = btn.dataset.filterValue;
        const sections = document.querySelectorAll<HTMLElement>(".series-section");
        let visibleCount = 0;

        sections.forEach((section) => {
          let sectionHasVisible = false;
          section.querySelectorAll<HTMLLIElement>(".card-list > li").forEach((li) => {
            const matches = type === "all" || (type === "series" && section.dataset.series === value);
            li.classList.toggle("is-hidden", !matches);
            if (matches) sectionHasVisible = true;
          });
          section.classList.toggle("is-hidden", !sectionHasVisible);
          if (sectionHasVisible) visibleCount++;
        });

        emptyMsg?.classList.toggle("is-visible", visibleCount === 0);
      });
    }
  </script>
</BaseLayout>
