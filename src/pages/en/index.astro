---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { seriesNamesEn, subSeriesNamesEn } from "../../consts";

const articles = (await getCollection("articlesEn", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.series.localeCompare(b.data.series) || a.data.order - b.data.order
);

const bySeries = Map.groupBy(articles, (a) => a.data.series);

// サブシリーズの表示順(main → supplementary → handson → それ以外はconsts.tsの登場順)
const subSeriesOrder = Object.keys(subSeriesNamesEn);
const subSeriesOf = (series: string) => {
  const values = new Set((bySeries.get(series) ?? []).map((a) => a.data.subSeries).filter((v): v is string => !!v));
  return [...values].sort((a, b) => {
    const ia = subSeriesOrder.indexOf(a);
    const ib = subSeriesOrder.indexOf(b);
    if (ia === -1 && ib === -1) return a.localeCompare(b);
    if (ia === -1) return 1;
    if (ib === -1) return -1;
    return ia - ib;
  });
};

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<BaseLayout
  title="Home"
  description="A technical blog aiming for the depth of understanding held by the top 1% of infrastructure engineers."
  lang="en"
  altHref="/"
>
  <div class="hero">
    <span class="eyebrow">// TOP 1% INFRA ENGINEERING</span>
    <h1>The depths of infrastructure, at top-1% resolution.</h1>
    <p>
      A technical blog aiming for the level of understanding held by top engineers at leading infrastructure
      companies like AWS and Google. Rather than memorizing operational steps, we dig into the internal
      mechanics and design rationale behind why things are built the way they are. The recommended reading
      order and how the series connect are summarized on the <a href="/en/sitemap">sitemap</a>.
    </p>
    <div class="hero-stats">
      <div><strong id="hero-article-count" data-total={articles.length}>{articles.length}</strong><span>articles</span></div>
      <div><strong>{bySeries.size}</strong><span>series</span></div>
    </div>
  </div>

  <div class="article-filters" id="article-filters">
    <span class="article-filters-label">Filter:</span>
    <button type="button" class="filter-chip filter-chip-reset is-active" data-filter-type="all">All</button>
    {
      [...bySeries.keys()].map((series) => (
        <button type="button" class="filter-chip" data-filter-type="series" data-filter-value={series}>
          {seriesNamesEn[series] ?? series}
        </button>
      ))
    }
  </div>

  <div class="article-subfilters" id="article-subfilters">
    {
      [...bySeries.keys()]
        .map((series) => ({ series, subs: subSeriesOf(series) }))
        .filter(({ subs }) => subs.length > 1)
        .map(({ series, subs }) => (
          <div class="subfilter-group" data-parent-series={series} hidden>
            <span class="article-filters-label">↳ Narrow down within {seriesNamesEn[series] ?? series}:</span>
            <button type="button" class="filter-chip filter-chip-reset is-active" data-filter-type="sub-all" data-parent-series={series}>
              All
            </button>
            {subs.map((sub) => (
              <button type="button" class="filter-chip" data-filter-type="sub-series" data-parent-series={series} data-filter-value={sub}>
                {subSeriesNamesEn[sub] ?? sub}
              </button>
            ))}
          </div>
        ))
    }
  </div>

  {
    [...bySeries.entries()].map(([series, items]) => (
      <section class="series-section" data-series={series}>
        <h2>
          {seriesNamesEn[series] ?? series}
          <span class="series-count" data-total={items.length}>{items.length}</span>
        </h2>
        <ul class="card-list">
          {items.map((article) => (
            <li data-sub-series={article.data.subSeries ?? ""}>
              <a class="card" href={`/en/articles/${article.id}`}>
                <p class="card-title">
                  {article.data.emoji ? `${article.data.emoji} ` : ""}
                  {article.data.title}
                </p>
                <p class="card-desc">{article.data.description}</p>
                <div class="card-meta">
                  <span class="card-date">{formatDate(article.data.pubDate)}</span>
                  {article.data.updatedDate && article.data.updatedDate.getTime() !== article.data.pubDate.getTime() && (
                    <span class="card-date card-date-updated">Updated: {formatDate(article.data.updatedDate)}</span>
                  )}
                  <ul class="tag-list">
                    {article.data.tags.map((tag: string) => (
                      <li class="tag">#{tag}</li>
                    ))}
                  </ul>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <p class="article-filters-empty" id="article-filters-empty">No matching articles found.</p>

  <script>
    const filterBar = document.getElementById("article-filters");
    const subFilterBar = document.getElementById("article-subfilters");
    const emptyMsg = document.getElementById("article-filters-empty");
    const heroCount = document.getElementById("hero-article-count");

    let activeSeries = "all";
    let activeSub = "all";

    function applyFilter() {
      const sections = document.querySelectorAll<HTMLElement>(".series-section");
      let visibleSectionCount = 0;
      let visibleArticleCount = 0;

      sections.forEach((section) => {
        const isActiveSeries = activeSeries === "all" || section.dataset.series === activeSeries;
        let sectionVisibleCount = 0;
        section.querySelectorAll<HTMLLIElement>(".card-list > li").forEach((li) => {
          const subMatches = activeSeries === "all" || activeSub === "all" || li.dataset.subSeries === activeSub;
          const matches = isActiveSeries && subMatches;
          li.classList.toggle("is-hidden", !matches);
          if (matches) sectionVisibleCount++;
        });
        section.classList.toggle("is-hidden", sectionVisibleCount === 0);
        if (sectionVisibleCount > 0) visibleSectionCount++;
        visibleArticleCount += sectionVisibleCount;

        const countEl = section.querySelector<HTMLElement>(".series-count");
        if (countEl) {
          const total = countEl.dataset.total ?? String(sectionVisibleCount);
          countEl.textContent = isActiveSeries && activeSub !== "all" ? `${sectionVisibleCount}/${total}` : total;
        }
      });

      if (heroCount) {
        const total = heroCount.dataset.total ?? String(visibleArticleCount);
        heroCount.textContent = activeSeries === "all" ? total : String(visibleArticleCount);
      }

      emptyMsg?.classList.toggle("is-visible", visibleSectionCount === 0);

      // Only show the sub-filter row for the currently selected series
      subFilterBar?.querySelectorAll<HTMLElement>(".subfilter-group").forEach((group) => {
        group.hidden = group.dataset.parentSeries !== activeSeries;
      });
    }

    filterBar?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-chip");
      if (!btn) return;

      filterBar.querySelectorAll(".filter-chip").forEach((c) => c.classList.remove("is-active"));
      btn.classList.add("is-active");

      activeSeries = btn.dataset.filterType === "series" ? (btn.dataset.filterValue ?? "all") : "all";
      activeSub = "all";

      // Reset the newly selected series's sub-filter row back to "All"
      subFilterBar?.querySelectorAll<HTMLElement>(`.subfilter-group[data-parent-series="${activeSeries}"] .filter-chip`).forEach((c) => {
        c.classList.toggle("is-active", c.getAttribute("data-filter-type") === "sub-all");
      });

      applyFilter();
    });

    subFilterBar?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-chip");
      if (!btn) return;

      const group = btn.closest<HTMLElement>(".subfilter-group");
      group?.querySelectorAll(".filter-chip").forEach((c) => c.classList.remove("is-active"));
      btn.classList.add("is-active");

      activeSub = btn.dataset.filterType === "sub-series" ? (btn.dataset.filterValue ?? "all") : "all";
      applyFilter();
    });
  </script>
</BaseLayout>
