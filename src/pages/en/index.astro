---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { seriesNamesEn } from "../../consts";

const articles = (await getCollection("articlesEn", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.series.localeCompare(b.data.series) || a.data.order - b.data.order
);

const bySeries = Map.groupBy(articles, (a) => a.data.series);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<BaseLayout
  title="Home"
  description="A technical blog aiming for the depth of understanding held by the top 1% of infrastructure engineers."
  lang="en"
  altHref="/"
>
  <div class="hero">
    <span class="eyebrow">// TOP 1% INFRA ENGINEERING</span>
    <h1>The depths of infrastructure, at top-1% resolution.</h1>
    <p>
      A technical blog aiming for the level of understanding held by top engineers at leading infrastructure
      companies like AWS and Google. Rather than memorizing operational steps, we dig into the internal
      mechanics and design rationale behind why things are built the way they are. The recommended reading
      order and how the series connect are summarized on the <a href="/en/sitemap">sitemap</a>.
    </p>
    <div class="hero-stats">
      <div><strong>{articles.length}</strong><span>articles</span></div>
      <div><strong>{bySeries.size}</strong><span>series</span></div>
    </div>
  </div>

  <div class="article-filters" id="article-filters">
    <span class="article-filters-label">Filter:</span>
    <button type="button" class="filter-chip filter-chip-reset is-active" data-filter-type="all">All</button>
    {
      [...bySeries.keys()].map((series) => (
        <button type="button" class="filter-chip" data-filter-type="series" data-filter-value={series}>
          {seriesNamesEn[series] ?? series}
        </button>
      ))
    }
  </div>

  {
    [...bySeries.entries()].map(([series, items]) => (
      <section class="series-section" data-series={series}>
        <h2>
          {seriesNamesEn[series] ?? series}
          <span class="series-count">{items.length}</span>
        </h2>
        <ul class="card-list">
          {items.map((article) => (
            <li>
              <a class="card" href={`/en/articles/${article.id}`}>
                <p class="card-title">
                  {article.data.emoji ? `${article.data.emoji} ` : ""}
                  {article.data.title}
                </p>
                <p class="card-desc">{article.data.description}</p>
                <div class="card-meta">
                  <span class="card-date">{formatDate(article.data.pubDate)}</span>
                  {article.data.updatedDate && article.data.updatedDate.getTime() !== article.data.pubDate.getTime() && (
                    <span class="card-date card-date-updated">Updated: {formatDate(article.data.updatedDate)}</span>
                  )}
                  <ul class="tag-list">
                    {article.data.tags.map((tag: string) => (
                      <li class="tag">#{tag}</li>
                    ))}
                  </ul>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <p class="article-filters-empty" id="article-filters-empty">No matching articles found.</p>

  <script>
    const filterBar = document.getElementById("article-filters");
    const emptyMsg = document.getElementById("article-filters-empty");
    if (filterBar) {
      filterBar.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-chip");
        if (!btn) return;

        filterBar.querySelectorAll(".filter-chip").forEach((c) => c.classList.remove("is-active"));
        btn.classList.add("is-active");

        const type = btn.dataset.filterType;
        const value = btn.dataset.filterValue;
        const sections = document.querySelectorAll<HTMLElement>(".series-section");
        let visibleCount = 0;

        sections.forEach((section) => {
          let sectionHasVisible = false;
          section.querySelectorAll<HTMLLIElement>(".card-list > li").forEach((li) => {
            const matches = type === "all" || (type === "series" && section.dataset.series === value);
            li.classList.toggle("is-hidden", !matches);
            if (matches) sectionHasVisible = true;
          });
          section.classList.toggle("is-hidden", !sectionHasVisible);
          if (sectionHasVisible) visibleCount++;
        });

        emptyMsg?.classList.toggle("is-visible", visibleCount === 0);
      });
    }
  </script>
</BaseLayout>
