---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { seriesNamesEn, ui } from "../../../consts";

export async function getStaticPaths() {
  const articles = await getCollection("articlesEn", ({ data }) => !data.draft);
  const bySeries = Map.groupBy(articles, (a) => a.data.series);
  for (const items of bySeries.values()) {
    items.sort((a, b) => a.data.order - b.data.order);
  }

  return articles.map((article) => {
    const siblings = bySeries.get(article.data.series) ?? [];
    const index = siblings.indexOf(article);
    return {
      params: { slug: article.id },
      props: {
        article,
        prev: index > 0 ? siblings[index - 1] : undefined,
        next: index < siblings.length - 1 ? siblings[index + 1] : undefined,
      },
    };
  });
}

const { article, prev, next } = Astro.props;
const { Content } = await render(article);
const t = ui.en;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "2-digit", day: "2-digit" });

const { pubDate, updatedDate } = article.data;
const hasUpdate = updatedDate && updatedDate.getTime() !== pubDate.getTime();
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  lang="en"
  altHref={`/articles/${article.id}`}
>
  <article>
    <span class="series-badge">{seriesNamesEn[article.data.series] ?? article.data.series}</span>
    <h1>{article.data.emoji ? `${article.data.emoji} ` : ""}{article.data.title}</h1>
    <div class="article-meta">
      <span class="card-date">{t.publishedLabel}: {formatDate(pubDate)}</span>
      {hasUpdate && <span class="card-date card-date-updated">{t.updatedLabel}: {formatDate(updatedDate)}</span>}
      <ul class="tag-list">
        {article.data.tags.map((tag: string) => (
          <li class="tag">#{tag}</li>
        ))}
      </ul>
    </div>
    <Content />
    {
      (prev || next) && (
        <nav class="series-nav">
          {prev ? (
            <a href={`/en/articles/${prev.id}`}>
              <span class="dir">{t.prevArticle}</span>
              {prev.data.title}
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a class="next" href={`/en/articles/${next.id}`}>
              <span class="dir">{t.nextArticle}</span>
              {next.data.title}
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
