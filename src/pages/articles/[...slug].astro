---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { seriesNames, ui } from "../../consts";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  const articlesEn = await getCollection("articlesEn", ({ data }) => !data.draft);
  const enIds = new Set(articlesEn.map((a) => a.id));
  const bySeries = Map.groupBy(articles, (a) => a.data.series);
  for (const items of bySeries.values()) {
    items.sort((a, b) => a.data.order - b.data.order);
  }

  return articles.map((article) => {
    const siblings = bySeries.get(article.data.series) ?? [];
    const index = siblings.indexOf(article);
    return {
      params: { slug: article.id },
      props: {
        article,
        prev: index > 0 ? siblings[index - 1] : undefined,
        next: index < siblings.length - 1 ? siblings[index + 1] : undefined,
        hasEnVersion: enIds.has(article.id),
      },
    };
  });
}

const { article, prev, next, hasEnVersion } = Astro.props;
const { Content } = await render(article);
const t = ui.ja;

const formatDate = (date: Date) =>
  date.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" }).replaceAll("/", ".");

const { pubDate, updatedDate } = article.data;
const hasUpdate = updatedDate && updatedDate.getTime() !== pubDate.getTime();
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  lang="ja"
  altHref={hasEnVersion ? `/en/articles/${article.id}` : "/en"}
>
  <article>
    <span class="series-badge">{seriesNames[article.data.series] ?? article.data.series}</span>
    <h1>{article.data.emoji ? `${article.data.emoji} ` : ""}{article.data.title}</h1>
    <div class="article-meta">
      <span class="card-date">{t.publishedLabel}: {formatDate(pubDate)}</span>
      {hasUpdate && <span class="card-date card-date-updated">{t.updatedLabel}: {formatDate(updatedDate)}</span>}
      <ul class="tag-list">
        {article.data.tags.map((tag: string) => (
          <li class="tag">#{tag}</li>
        ))}
      </ul>
      <button type="button" class="share-btn" data-copied-label="URLをコピーしました" data-default-label="🔗 記事を共有">
        🔗 記事を共有
      </button>
    </div>
    <Content />
    {
      (prev || next) && (
        <nav class="series-nav">
          {prev ? (
            <a href={`/articles/${prev.id}`}>
              <span class="dir">{t.prevArticle}</span>
              {prev.data.title}
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a class="next" href={`/articles/${next.id}`}>
              <span class="dir">{t.nextArticle}</span>
              {next.data.title}
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>

  <section class="giscus-section">
    <h2>コメント</h2>
    <p class="giscus-hint">記事の感想や、疑問点、指摘などがあれば気軽にどうぞ(GitHubアカウントでログインするとコメント・リアクションできます)。</p>
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo="koikoi1998/koikoi-blog-20260723"
      data-repo-id="R_kgDOTXNp-A"
      data-category="Announcements"
      data-category-id="DIC_kwDOTXNp-M4DC7tI"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="ja"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>(".share-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const url = window.location.href;
        try {
          if (navigator.clipboard) {
            await navigator.clipboard.writeText(url);
          } else {
            const textarea = document.createElement("textarea");
            textarea.value = url;
            textarea.style.position = "fixed";
            textarea.style.opacity = "0";
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand("copy");
            document.body.removeChild(textarea);
          }
          const copiedLabel = btn.dataset.copiedLabel ?? "Copied!";
          const defaultLabel = btn.dataset.defaultLabel ?? btn.textContent ?? "";
          btn.textContent = copiedLabel;
          btn.classList.add("is-copied");
          setTimeout(() => {
            btn.textContent = defaultLabel;
            btn.classList.remove("is-copied");
          }, 2000);
        } catch {
          // Clipboard access denied or unavailable; silently ignore.
        }
      });
    });
  </script>
</BaseLayout>
