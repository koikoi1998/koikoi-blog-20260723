---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { ui, type Lang } from "../consts";

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  /** 同じページの、もう一方の言語版の絶対パス(例: "/en/articles/idrac-guide")。未指定ならその言語のトップページにフォールバックする。 */
  altHref?: string;
}

const { title, description, lang = "ja", altHref } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} | ${t.siteName}` : t.siteName;
const otherLang: Lang = lang === "ja" ? "en" : "ja";
const resolvedAltHref = altHref ?? (lang === "ja" ? "/en" : "/");
const homeHref = lang === "ja" ? "/" : "/en";
const sitemapHref = lang === "ja" ? "/sitemap" : "/en/sitemap";
const quizHref = lang === "ja" ? "/quiz" : "/en/quiz";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(resolvedAltHref, Astro.site);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="google-site-verification" content="jeeCiUlGJdW8YO3B_JlsCNcu1DuOO61SY2nafTseb84" />
    <meta name="google-site-verification" content="kHaW-1XTWMvbRZS41FCdAKlqicPN5xd_7zkUyhtJb3I" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={otherLang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={lang === "ja" ? canonicalUrl : altUrl} />
    <Analytics />
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href={homeHref} class="brand">
          <span class="brand-mark">{t.siteName}</span>
          <span class="brand-tagline">{t.tagline}</span>
        </a>
        <div class="nav-links">
          <a href={sitemapHref}>{t.sitemap}</a>
          <a href={quizHref}>{t.quiz}</a>
          <a href={resolvedAltHref} class="lang-switch" rel="alternate" hreflang={otherLang}>{t.langSwitchLabel}</a>
        </div>
      </nav>
    </header>
    <main class="page">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="page">
        <span>© {new Date().getFullYear()} {t.siteName}</span>
        <span class="stack">Astro + Vercel</span>
      </div>
    </footer>
    <script>
      import mermaid from "mermaid";

      mermaid.initialize({ startOnLoad: false, theme: "neutral" });
      mermaid.run({ querySelector: ".mermaid" });
    </script>
  </body>
</html>
